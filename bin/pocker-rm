#!/usr/bin/env bash

RUNC_ROOT="/opt/pocker/runtime"

if [ "$#" -eq 0 ]; then
  echo "container id required"
  exit 1
fi

for CID in "$@"; do

  CTR_DIR="/opt/pocker/containers/$CID"

  if [ ! -d "$CTR_DIR" ]; then
    echo "container $CID not found"
    continue
  fi

  # Check real runtime state
  STATE=$(runc --root "$RUNC_ROOT" state "$CID" 2>/dev/null | grep '"status"' | awk -F'"' '{print $4}')

  if [ "$STATE" = "running" ]; then
    echo "cannot remove container $CID: container is running"
    continue
  fi

  # Ensure runtime state removed
  runc --root "$RUNC_ROOT" delete -f "$CID" >/dev/null 2>&1 || true

  rm -rf "$CTR_DIR"

  echo "$CID removed"

done
