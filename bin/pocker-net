#!/usr/bin/env bash
set -e

CID="$1"
[ -z "$CID" ] && { echo "container id required"; exit 1; }

PID=$(runc state "$CID" | awk -F: '/"pid"/ {gsub(/[ ,]/,"",$2); print $2}')
[ "$PID" = "0" ] && { echo "container not running"; exit 1; }

BRIDGE="pocker0"
SUBNET="10.0.0.0/24"
GATEWAY="10.0.0.1"
IP="10.0.0.$((RANDOM%200+2))"

# auto-detect outbound interface
EXT_IF=$(ip route | awk '/default/ {print $5; exit}')

# create bridge once
if ! ip link show $BRIDGE &>/dev/null; then
    ip link add $BRIDGE type bridge
    ip addr add $GATEWAY/24 dev $BRIDGE
    ip link set $BRIDGE up
fi

# create veth
VETH_HOST="veth-${CID:0:5}"
VETH_CONT="eth0"

ip link del $VETH_HOST 2>/dev/null || true
ip link add $VETH_HOST type veth peer name $VETH_CONT
ip link set $VETH_HOST master $BRIDGE
ip link set $VETH_HOST up
ip link set $VETH_CONT netns $PID

# configure container side
nsenter -t $PID -n ip link set lo up
nsenter -t $PID -n ip addr add $IP/24 dev $VETH_CONT
nsenter -t $PID -n ip link set $VETH_CONT up
nsenter -t $PID -n ip route add default via $GATEWAY

# enable forwarding
echo 1 > /proc/sys/net/ipv4/ip_forward

# clean old rule (if any) and add MASQUERADE
iptables -t nat -D POSTROUTING -s $SUBNET -o $EXT_IF -j MASQUERADE 2>/dev/null || true
iptables -t nat -A POSTROUTING -s $SUBNET -o $EXT_IF -j MASQUERADE

# allow forwarding
iptables -C FORWARD -i $BRIDGE -j ACCEPT 2>/dev/null || \
iptables -A FORWARD -i $BRIDGE -j ACCEPT

iptables -C FORWARD -o $BRIDGE -j ACCEPT 2>/dev/null || \
iptables -A FORWARD -o $BRIDGE -j ACCEPT

# DNS
mkdir -p /proc/$PID/root/etc
echo "nameserver 8.8.8.8" > /proc/$PID/root/etc/resolv.conf
echo "nameserver 1.1.1.1" >> /proc/$PID/root/etc/resolv.conf

echo "Network attached: $IP via $EXT_IF"
